@using Microsoft.AspNetCore.Identity;
@model IEnumerable<Shoe>

<div class="row row-cols-1 row-cols-md-3 g-4">
    @foreach (var shoe in Model)
    {
        <ul>
        <div class="col">
            <div class="card">
                <img src="@Url.Action("GetShoeImage", "Home", new {id = shoe.Uid})" class="card-img-top" alt="...">
                <div class="card-body">
                    <h5 class="card-title">Price: @shoe.Price</h5>
                    <h5 class="card-title">Size: @shoe.Size</h5>
                    <h5 class="card-title">Type: @shoe.Brand.Type</h5>
                    <a class="btn btn-danger" href="/Admin/AdminDelete?uid=@shoe.Uid">Delete</a>
                </div>
            </div>
        </div>
        </ul>
    }
</div>