@using Microsoft.AspNetCore.Identity;
@model IEnumerable<Shoe>

@foreach (var shoe in Model.GroupBy(t => t.Price))
{
    <li>
        @shoe.Key
        <ul>
            @foreach (var item in shoe)
            {
                <li>
                    <img src="@Url.Action("GetImage", "Home", new {userid = item.OwnerId})" />
                    @item.Owner.FirstName @item.Owner.LastName
                    <a href="AdminDelete?uid=@item.Uid">Delete</a>
                </li>
            }
        </ul>
    </li>
}