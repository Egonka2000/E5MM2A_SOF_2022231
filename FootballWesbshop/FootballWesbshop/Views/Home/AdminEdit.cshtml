@using Microsoft.AspNetCore.Identity;
@model IEnumerable<Shoe>

@foreach (var shoe in Model.GroupBy(t => t.Price))
{
    <li>
        @shoe.Key
        <ul>
            @foreach (var item in shoe)
            {
                <li>
                    <img src="@Url.Action("GetShoeImage", "Home", new {id = item.Uid})" />
                    
                    <a class="btn btn-danger" href="AdminDelete?uid=@item.Uid">Delete</a>
                </li>
            }
        </ul>
    </li>
}