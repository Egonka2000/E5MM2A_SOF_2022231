@using Microsoft.AspNetCore.Identity;
@model IEnumerable<Shoe>
@inject SignInManager<SiteUser> SignInManager
@inject UserManager<SiteUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var shoe in Model)
        {
                <div class="col">
                    <div class="card">
                        <img src="@shoe.PhotoUrl" class="card-img-top" alt="...">
                        <div class="card-body">
                            <h5 class="card-title">Price: @shoe.Price</h5>
                            <h5 class="card-title">Size: @shoe.Size</h5>
                            <h5 class="card-title">Type: @shoe.Brand.Type</h5>
                            <a class="btn btn-danger" href="RemoveFromCart?shoeid=@shoe.Uid">Remove From Cart</a>
                        </div>
                    </div>
                </div>
        }
    </div>
    <br />
    @if(Model.Count() != 0)
    {
        <a class="btn btn-success" href="Order">Order</a>
    }
    else
    {
        <h1>Your cart is empty!</h1>
    }
}
